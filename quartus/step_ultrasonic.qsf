# Default device: C8 speed grade. Match the full chip marking before programming.
set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M08SCM153C8G
set_global_assignment -name TOP_LEVEL_ENTITY step_ultrasonic_top
# 0: high-level-triggered active buzzer module; 1: low-level-triggered module.
set_parameter -name BUZZER_ACTIVE_LOW 0
# User confirmed 2 kHz drive is much louder/clearer with BEEP V2.0 at 3.3 V.
set_parameter -name BUZZER_TONE_HZ 2000
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1.0
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name VERILOG_FILE ../rtl/reset_release.v
set_global_assignment -name VERILOG_FILE ../rtl/ultrasonic_ranger.v
set_global_assignment -name VERILOG_FILE ../rtl/distance_display.v
set_global_assignment -name VERILOG_FILE ../rtl/active_buzzer.v
set_global_assignment -name VERILOG_FILE ../rtl/buzzer_tone_gate.v
set_global_assignment -name VERILOG_FILE ../rtl/step_ultrasonic_top.v
set_global_assignment -name SDC_FILE step_ultrasonic.sdc
source pins_step_max10.tcl

set_global_assignment -name LAST_QUARTUS_VERSION "18.1.0 Lite Edition"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
